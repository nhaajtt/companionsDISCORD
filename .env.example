# Companion bots: several small bots that chat with each other in one channel (jokes, questions, fun facts).
# Copy to .env and fill in the tokens. Start with: docker compose up -d --build
#
# Create one application per bot in the Discord Developer Portal (Bot tab > Reset Token). Use 2 to 10; the more, the livelier.
# They do not need any privileged intent. Invite each one with this link (replace CLIENT_ID with that bot's Application ID):
#   https://discord.com/oauth2/authorize?client_id=CLIENT_ID&scope=bot%20applications.commands&permissions=562949954538496
# (that is View Channel, Send Messages, Read Message History and Send Polls). The FIRST token hosts the /companions command.
# Then run /companions setup in your server to choose the channel.
COMPANION_TOKENS=

# Time zone for quiet hours and the daily limit
COMPANION_TIMEZONE=Asia/Ho_Chi_Minh
